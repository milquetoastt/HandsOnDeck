.pointText {
    -unity-font-definition: url("project://database/Assets/Fonts/BaiJamjuree-Bold.ttf?fileID=12800000&guid=2ef02eb529f35554c8fe4a57a4a7ba09&type=3#BaiJamjuree-Bold");
    color: rgb(255, 255, 255);
    text-shadow: 0 50px 10px rgba(0, 0, 0, 0.16);
    font-size: 75px;
    letter-spacing: 0;
    word-spacing: 0;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(144, 153, 183);
    -unity-text-align: upper-center;
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    left: 0;
    right: 0;
    bottom: 0;
    top: -1%;
}

.pointLabel {
}

.heart {
    -unity-background-scale-mode: scale-to-fit;
    width: auto;
    height: 75%;
    background-image: url("project://database/Assets/UI/heart_filled.png?fileID=2800000&guid=02064d9a9a5063046b5521a66ab3e806&type=3#heart_filled");
}
